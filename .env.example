DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Optionnelle : sans elle, le seed utilise des affiches placeholder et des
# genres de repli. Clé API TMDB v3 gratuite : https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# Secret arbitraire (ex: généré avec `openssl rand -hex 16`) pour autoriser
# GET /api/admin/seed?secret=... à distance (utile sur Vercel, sans terminal).
ADMIN_SEED_SECRET=""
