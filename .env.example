DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Clé API TMDB (v3, gratuite sur themoviedb.org/settings/api) : nécessaire
# pour piocher des films sur les plateformes "découverte" (Netflix,
# Disney+, Prime Video, OCS, HBO, Canal+) en plus de Plex — voir
# src/lib/tmdb/. Sans elle, la synchro "découverte" échoue proprement et
# seule la bibliothèque Plex (ou les mocks seedés) est utilisée.
TMDB_API_KEY=""
