// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// v0: un seul foyer (couple) avec exactement 2 membres, pas d'authentification.
// Les comptes / multi-foyers arriveront en v3.
model Household {
  id      String   @id @default(cuid())
  name    String
  members Member[]
  sessions Session[]
  movies  Movie[]
  watchHistory WatchHistory[]

  // Connexion Plex (v2) : identifiant d'appareil stable + jeton de compte
  // plex.tv, puis serveur retenu après découverte via /api/v2/resources.
  // Un seul foyer en v0/v1, donc pas de table à part : ces champs suffisent.
  plexClientId          String?
  plexAuthToken         String?
  plexServerId          String?
  plexServerName        String?
  plexServerBaseUrl     String?
  plexServerAccessToken String?
  plexLastSyncedAt      DateTime?

  createdAt DateTime @default(now())
}

model Member {
  id          String   @id @default(cuid())
  name        String
  household   Household @relation(fields: [householdId], references: [id])
  householdId String

  rankings Ranking[]
  orientationAnswers OrientationAnswer[]

  createdAt DateTime @default(now())
}

enum MovieSource {
  PLEX
  DISCOVERY
}

model Movie {
  id          String   @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id])
  householdId String

  tmdbId      Int?
  plexKey     String?
  // Identifiant "watch.plex.tv/movie/{slug}" renvoyé par le serveur Plex :
  // seul lien fiable pour ouvrir l'appli Plex (iOS/Android) directement sur
  // la fiche du film — absent si Plex n'a pas pu faire correspondre le film
  // à une entrée de son catalogue (vidéo perso non reconnue, etc.).
  plexSlug    String?
  // true si le film est marqué comme vu sur le serveur Plex (viewCount > 0
  // au moment de la dernière synchro) : il n'est alors plus proposé au tirage.
  plexWatched Boolean  @default(false)
  title       String
  year        Int
  posterUrl   String
  synopsis    String
  runtimeMin  Int
  genre       String   @default("")
  platform    String // "Plex" pour tous les films désormais (v0/v1 avaient d'autres plateformes)
  source      MovieSource

  sessionMovies SessionMovie[]
  watchHistory  WatchHistory[]

  createdAt DateTime @default(now())

  @@unique([householdId, plexKey])
  @@index([householdId])
}

enum SessionStatus {
  PENDING   // en attente que les 2 aient soumis leur classement
  REVEALED  // resultat calcule et visible
}

model Session {
  id          String   @id @default(cuid())
  code        String   @unique
  household   Household @relation(fields: [householdId], references: [id])
  householdId String
  status      SessionStatus @default(PENDING)
  // Posé au moment où l'un des deux déclenche le tirage : évite un double
  // tirage si les deux réponses arrivent en même temps (voir src/lib/sessionDraw.ts).
  drawnAt     DateTime?

  sessionMovies SessionMovie[]
  orientationAnswers OrientationAnswer[]
  rankings      Ranking[]
  result        SessionResult?
  watchHistory  WatchHistory[]

  createdAt DateTime @default(now())
}

// Réponses d'un membre aux questions d'orientation (mood, temps, veto,
// époque) : le tirage a lieu quand les deux ont répondu, en mélangeant les
// réponses (voir src/lib/orientation.ts). null = "peu importe".
model OrientationAnswer {
  id        String   @id @default(cuid())
  session   Session  @relation(fields: [sessionId], references: [id])
  sessionId String
  member    Member   @relation(fields: [memberId], references: [id])
  memberId  String
  mood      String?
  time      String?
  vetoes    String[]
  era       String?
  // true si la personne a cliqué sur "Passer les questions".
  skipped   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([sessionId, memberId])
}

model SessionMovie {
  id        String  @id @default(cuid())
  session   Session @relation(fields: [sessionId], references: [id])
  sessionId String
  movie     Movie   @relation(fields: [movieId], references: [id])
  movieId   String
  // false si ce film a été ajouté en complément (pas assez de films
  // correspondant aux préférences répondues) plutôt que réellement tiré
  // parmi ceux qui correspondent — voir src/lib/draw.ts.
  matchesFilters Boolean @default(true)

  @@unique([sessionId, movieId])
}

model Ranking {
  id        String   @id @default(cuid())
  session   Session  @relation(fields: [sessionId], references: [id])
  sessionId String
  member    Member   @relation(fields: [memberId], references: [id])
  memberId  String
  // ordre des movieId du session, du plus envie (index 0) au moins envie
  order     String // JSON.stringify(string[])
  submittedAt DateTime @default(now())

  @@unique([sessionId, memberId])
}

model SessionResult {
  session       Session @relation(fields: [sessionId], references: [id])
  sessionId     String  @id
  winnerMovieId String
  scores        String // JSON: { movieId: { points, disqualified } }[]
  computedAt    DateTime @default(now())
}

enum WatchStatus {
  PROPOSED
  REJECTED_LAST
  WATCHED
}

model WatchHistory {
  id          String   @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id])
  householdId String
  movie       Movie    @relation(fields: [movieId], references: [id])
  movieId     String
  session     Session? @relation(fields: [sessionId], references: [id])
  sessionId   String?
  status      WatchStatus
  createdAt   DateTime @default(now())

  @@index([householdId, movieId])
}
