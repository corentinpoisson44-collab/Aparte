// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// v0: un seul foyer (couple) avec exactement 2 membres, pas d'authentification.
// Les comptes / multi-foyers arriveront en v3.
model Household {
  id      String   @id @default(cuid())
  name    String
  members Member[]
  sessions Session[]
  movies  Movie[]
  watchHistory WatchHistory[]

  // Connexion Plex (v2) : identifiant d'appareil stable + jeton de compte
  // plex.tv, puis serveur retenu après découverte via /api/v2/resources.
  // Un seul foyer en v0/v1, donc pas de table à part : ces champs suffisent.
  plexClientId          String?
  plexAuthToken         String?
  plexServerId          String?
  plexServerName        String?
  plexServerBaseUrl     String?
  plexServerAccessToken String?
  plexLastSyncedAt      DateTime?

  // Plateformes de streaming "découverte" (v1) sélectionnées par le foyer :
  // clés parmi celles listées dans src/lib/tmdb/constants.ts, utilisées pour
  // filtrer la pioche TMDB (voir src/lib/tmdb/discovery.ts). Vide par défaut
  // : seule la bibliothèque Plex est alors piochée, comme avant.
  discoveryPlatforms    String[]  @default([])
  discoveryLastSyncedAt DateTime?

  createdAt DateTime @default(now())
}

model Member {
  id          String   @id @default(cuid())
  name        String
  household   Household @relation(fields: [householdId], references: [id])
  householdId String

  rankings Ranking[]

  createdAt DateTime @default(now())
}

enum MovieSource {
  PLEX
  DISCOVERY
}

model Movie {
  id          String   @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id])
  householdId String

  // Id TMDB : clé d'upsert des films "découverte" (source = DISCOVERY),
  // voir src/lib/tmdb/discovery.ts. Absent pour les films Plex.
  tmdbId      Int?
  plexKey     String?
  // Identifiant "watch.plex.tv/movie/{slug}" renvoyé par le serveur Plex :
  // seul lien fiable pour ouvrir l'appli Plex (iOS/Android) directement sur
  // la fiche du film — absent si Plex n'a pas pu faire correspondre le film
  // à une entrée de son catalogue (vidéo perso non reconnue, etc.).
  plexSlug    String?
  title       String
  year        Int
  posterUrl   String
  synopsis    String
  runtimeMin  Int
  genre       String   @default("")
  platform    String // "Plex" pour tous les films désormais (v0/v1 avaient d'autres plateformes)
  source      MovieSource

  sessionMovies SessionMovie[]
  watchHistory  WatchHistory[]

  createdAt DateTime @default(now())

  @@unique([householdId, plexKey])
  @@unique([householdId, tmdbId])
  @@index([householdId])
}

enum SessionStatus {
  PENDING   // en attente que les 2 aient soumis leur classement
  REVEALED  // resultat calcule et visible
}

model Session {
  id          String   @id @default(cuid())
  code        String   @unique
  household   Household @relation(fields: [householdId], references: [id])
  householdId String
  status      SessionStatus @default(PENDING)

  sessionMovies SessionMovie[]
  rankings      Ranking[]
  result        SessionResult?
  watchHistory  WatchHistory[]

  createdAt DateTime @default(now())
}

model SessionMovie {
  id        String  @id @default(cuid())
  session   Session @relation(fields: [sessionId], references: [id])
  sessionId String
  movie     Movie   @relation(fields: [movieId], references: [id])
  movieId   String
  // false si ce film a été ajouté en complément (pas assez de films
  // correspondant aux préférences répondues) plutôt que réellement tiré
  // parmi ceux qui correspondent — voir src/lib/draw.ts.
  matchesFilters Boolean @default(true)

  @@unique([sessionId, movieId])
}

model Ranking {
  id        String   @id @default(cuid())
  session   Session  @relation(fields: [sessionId], references: [id])
  sessionId String
  member    Member   @relation(fields: [memberId], references: [id])
  memberId  String
  // ordre des movieId du session, du plus envie (index 0) au moins envie
  order     String // JSON.stringify(string[])
  submittedAt DateTime @default(now())

  @@unique([sessionId, memberId])
}

model SessionResult {
  session       Session @relation(fields: [sessionId], references: [id])
  sessionId     String  @id
  winnerMovieId String
  scores        String // JSON: { movieId: { points, disqualified } }[]
  computedAt    DateTime @default(now())
}

enum WatchStatus {
  PROPOSED
  REJECTED_LAST
  WATCHED
}

model WatchHistory {
  id          String   @id @default(cuid())
  household   Household @relation(fields: [householdId], references: [id])
  householdId String
  movie       Movie    @relation(fields: [movieId], references: [id])
  movieId     String
  session     Session? @relation(fields: [sessionId], references: [id])
  sessionId   String?
  status      WatchStatus
  createdAt   DateTime @default(now())

  @@index([householdId, movieId])
}
